# What a remote build uploads from your working tree. CI checkouts carry none
# of this, so it only matters for a deploy run from your own machine; without
# it, node_modules and your local database ship to the builder.
.git
node_modules
dist
.astro
.data
*.log
.env
.env.*
.envrc
mise.local.toml
*.pem
.claude

# source screenshots for course-data.ts; never needed by a build
enrolment_flow
