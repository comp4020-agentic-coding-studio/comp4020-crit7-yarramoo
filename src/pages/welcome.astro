---
import Portal from "../layouts/Portal.astro";
import { getSessionUser } from "../lib/auth";
import { PORTAL_NAME } from "../lib/site";

const username = getSessionUser(Astro.cookies);
if (!username) return Astro.redirect("/login/", 302);
---

<Portal title={`Welcome — ${PORTAL_NAME}`} heading="Welcome" username={username}>
  <div class="auth-card">
    <p>
      Hi <strong>{username}</strong> — first time we've seen this username, so there's no course
      history for it yet. Want a plausible one made up — a 1st/2nd/3rd year student whose
      completed courses actually satisfy each other's prerequisites — so there's something to
      look at straight away? You can always fix it up by hand afterwards in god mode.
    </p>
    <div class="button-row">
      <form method="post" action="/api/onboard">
        <input type="hidden" name="action" value="random" />
        <button class="button button-primary">Make up a transcript for me</button>
      </form>
      <form method="post" action="/api/onboard">
        <input type="hidden" name="action" value="skip" />
        <button class="button">Start with nothing completed</button>
      </form>
    </div>
  </div>
</Portal>
