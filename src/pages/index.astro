---
import { getSessionUser } from "../lib/auth";
import { getCatalogueForUser } from "../lib/db";
import "../styles.css";

const username = getSessionUser(Astro.cookies);
const catalogue = username ? getCatalogueForUser(username) : [];

const STATUS_LABEL: Record<string, string> = {
  eligible: "Eligible now",
  blocked: "Not eligible",
  enrolled: "Already enrolled",
  passed: "Completed — passed",
  failed: "Completed — failed",
};

// Group by status so the whole "which bucket am I in" question the real
// enrolment flow only answers at the last step is answered here up front.
const order = ["eligible", "enrolled", "blocked", "passed", "failed"] as const;
const buckets = order
  .map((status) => ({ status, courses: catalogue.filter((c) => c.status === status) }))
  .filter((bucket) => bucket.courses.length > 0);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Enrol in a course</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Enrol</a>
      {username && <a href="/god-mode/">God mode</a>}
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Enrol in a course</h1>
      {
        !username ? (
          <p>
            <a href="/login/">Log in</a> to see which courses you're eligible for.
          </p>
        ) : (
          <>
            <p class="session-line">
              Signed in as {username}. <form method="post" action="/api/logout" class="inline-form"><button>Log out</button></form>
            </p>
            <p>
              Courses are sorted by whether your transcript already clears them — no more finding
              out you needed a prerequisite on the last screen.
            </p>
            {buckets.map((bucket) => (
              <section class={`bucket bucket-${bucket.status}`}>
                <h2>{STATUS_LABEL[bucket.status]}</h2>
                <ul>
                  {bucket.courses.map((course) => (
                    <li>
                      <span class="code">{course.code}</span> {course.title}
                      <span class="terms">({course.terms})</span>
                      {course.status === "eligible" && (
                        <form method="post" action="/api/enrol" class="inline-form">
                          <input type="hidden" name="code" value={course.code} />
                          <button>Enrol</button>
                        </form>
                      )}
                      {course.status === "blocked" && (
                        <p class="why">
                          {course.requiresPermission && "Needs a permission code from the School. "}
                          {course.groups.length > 0 &&
                            `Requires: ${course.groups.map((g) => g.join(" or ")).join(" and ")}. `}
                          {course.prereqNote}
                        </p>
                      )}
                      {course.status !== "blocked" && course.prereqNote && (
                        <p class="why">{course.prereqNote}</p>
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </>
        )
      }
    </main>
  </body>
</html>
