---
// Tile illustrations were generated with recraft-v3 in one shared style prompt,
// then trimmed and shrunk into public/tiles/<name>.png. Decorative: the tile
// title already names the service.
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<img class="tile-icon" src={`/tiles/${name}.png`} alt="" width="84" height="84" loading="lazy" />

<style>
  .tile-icon {
    width: 84px;
    height: 84px;
    /* The art sits on white; multiply drops that white into whatever tint the tile has. */
    mix-blend-mode: multiply;
  }
</style>
