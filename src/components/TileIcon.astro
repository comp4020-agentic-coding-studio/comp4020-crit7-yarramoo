    <path d="M62 18c0-3 2-4 4-5" fill="none" stroke="${NAVY}" stroke-width="2" stroke-linecap="round"/>
  `,
  requests: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <path d="M26 44l22-14 22 14v28H26z" fill="#fff" stroke="${NAVY}" stroke-width="3" stroke-linejoin="round"/>
    <line x1="20" y1="44" x2="76" y2="44" stroke="${NAVY}" stroke-width="3"/>
    <rect x="38" y="54" width="14" height="18" fill="${NAVY_BG}" stroke="${NAVY}" stroke-width="2"/>
    <rect x="56" y="56" width="16" height="20" rx="1" fill="#fff" stroke="${ACCENT}" stroke-width="2.5"/>
    <line x1="59" y1="62" x2="69" y2="62" stroke="${ACCENT}" stroke-width="2"/>
    <line x1="59" y1="68" x2="69" y2="68" stroke="${ACCENT}" stroke-width="2"/>
  `,
  graduation: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <path d="M48 30L16 44l32 13 32-13z" fill="${NAVY}"/>
    <path d="M32 51v13c0 5.5 7.2 10 16 10s16-4.5 16-10V51" fill="none" stroke="${NAVY}" stroke-width="3" stroke-linecap="round"/>
    <line x1="76" y1="44" x2="76" y2="63" stroke="${ACCENT}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="76" cy="67" r="3.5" fill="${ACCENT}"/>
  `,
  charges: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <ellipse cx="40" cy="63" rx="18" ry="8" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5"/>
    <ellipse cx="40" cy="55" rx="18" ry="8" fill="${PALE_ACCENT}" stroke="${NAVY}" stroke-width="2.5"/>
    <ellipse cx="58" cy="43" rx="18" ry="8" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5"/>
    <ellipse cx="58" cy="35" rx="18" ry="8" fill="${PALE_ACCENT}" stroke="${NAVY}" stroke-width="2.5"/>
