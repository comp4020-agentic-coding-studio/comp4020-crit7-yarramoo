---
// Flat, two-tone placeholder illustrations for homepage tiles, in the spirit
// of PeopleSoft tile art: simple outlined objects with pastel fills, in the
// Molonglo palette (navy #1f2f4a, terracotta #a4471f, plus pastel tints of
// each). Purely decorative — the wrapping <svg> is aria-hidden. One entry per
// tile "icon" name; keep this the only place that knows the palette details
// so the coordinator can swap these for generated art later without touching
// callers.
interface Props {
  name: string;
}

const { name } = Astro.props;

const NAVY = "#1f2f4a";
const ACCENT = "#a4471f";
const ACCENT_SOFT = "#c5714a";
const SAND_BG = "#f4e6d7";
const NAVY_BG = "#dfe6ee";
const PALE_ACCENT = "#f0cdb2";

const icons: Record<string, string> = {
  announcements: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <path d="M28 40h14l24-12v40l-24-12H28a6 6 0 01-6-6v-4a6 6 0 016-6z" fill="${NAVY_BG}" stroke="${NAVY}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M66 34a10 10 0 010 20" fill="none" stroke="${ACCENT}" stroke-width="3" stroke-linecap="round"/>
    <path d="M36 56l4 13a5 5 0 004.6 3.4 5 5 0 004.6-6.9l-3-9.5" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2" stroke-linejoin="round"/>
  `,
  tasks: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <rect x="30" y="22" width="36" height="52" rx="4" fill="#fff" stroke="${NAVY}" stroke-width="3"/>
    <rect x="40" y="18" width="16" height="8" rx="2" fill="${ACCENT}"/>
    <path d="M37 38l4 4 8-8" fill="none" stroke="${NAVY}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="55" y1="40" x2="60" y2="40" stroke="${NAVY}" stroke-width="3" stroke-linecap="round"/>
    <path d="M37 55l4 4 8-8" fill="none" stroke="${NAVY}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="55" y1="57" x2="60" y2="57" stroke="${NAVY}" stroke-width="3" stroke-linecap="round"/>
    <line x1="36" y1="68" x2="60" y2="68" stroke="${ACCENT}" stroke-width="3" stroke-linecap="round"/>
  `,
  enrolment: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <rect x="22" y="26" width="34" height="40" rx="4" fill="#fff" stroke="${NAVY}" stroke-width="3"/>
    <line x1="22" y1="36" x2="56" y2="36" stroke="${NAVY}" stroke-width="3"/>
    <line x1="30" y1="20" x2="30" y2="30" stroke="${NAVY}" stroke-width="3" stroke-linecap="round"/>
    <line x1="48" y1="20" x2="48" y2="30" stroke="${NAVY}" stroke-width="3" stroke-linecap="round"/>
    <circle cx="66" cy="60" r="16" fill="#fff" stroke="${ACCENT}" stroke-width="3"/>
    <line x1="66" y1="60" x2="66" y2="50" stroke="${ACCENT}" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="66" y1="60" x2="73" y2="63" stroke="${ACCENT}" stroke-width="2.5" stroke-linecap="round"/>
  `,
  records: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <path d="M36 62l-6 18 10-4.5 7 9.5 6-19" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5" stroke-linejoin="round"/>
    <path d="M60 62l6 18-10-4.5-7 9.5-6-19" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="48" cy="42" r="22" fill="#fff" stroke="${NAVY}" stroke-width="3"/>
    <path d="M38 42l7 7 13-15" fill="none" stroke="${NAVY}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
  `,
  timetable: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <rect x="22" y="26" width="52" height="44" rx="4" fill="#fff" stroke="${NAVY}" stroke-width="3"/>
    <rect x="22" y="26" width="52" height="12" rx="4" fill="${NAVY}"/>
    <line x1="32" y1="20" x2="32" y2="32" stroke="${ACCENT}" stroke-width="3" stroke-linecap="round"/>
    <line x1="64" y1="20" x2="64" y2="32" stroke="${ACCENT}" stroke-width="3" stroke-linecap="round"/>
    <rect x="30" y="46" width="8" height="8" fill="${ACCENT}"/>
    <rect x="44" y="46" width="8" height="8" fill="${NAVY}" opacity="0.45"/>
    <rect x="58" y="46" width="8" height="8" fill="${NAVY}" opacity="0.45"/>
    <rect x="30" y="58" width="8" height="8" fill="${NAVY}" opacity="0.45"/>
  `,
  degree: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <rect x="20" y="58" width="56" height="10" rx="2" fill="${NAVY}"/>
    <rect x="24" y="48" width="48" height="10" rx="2" fill="${ACCENT}"/>
