  account: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <path d="M48 20l27 15H21z" fill="${NAVY}"/>
    <rect x="19" y="66" width="58" height="8" fill="${NAVY}"/>
    <rect x="26" y="39" width="8" height="26" fill="#fff" stroke="${NAVY}" stroke-width="2.5"/>
    <rect x="44" y="39" width="8" height="26" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5"/>
    <rect x="62" y="39" width="8" height="26" fill="#fff" stroke="${NAVY}" stroke-width="2.5"/>
  `,
  scholarships: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <path d="M34 22l14 18 14-18" fill="none" stroke="${ACCENT}" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
    <circle cx="48" cy="58" r="20" fill="#fff" stroke="${NAVY}" stroke-width="3"/>
    <circle cx="48" cy="58" r="12" fill="${ACCENT}"/>
    <path d="M48 51l2.3 4.7 5.2.7-3.8 3.7.9 5.2-4.6-2.4-4.6 2.4.9-5.2-3.8-3.7 5.2-.7z" fill="#fff"/>
  `,
  personal: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <circle cx="48" cy="38" r="14" fill="${PALE_ACCENT}" stroke="${NAVY}" stroke-width="3"/>
    <path d="M22 78c2-17 12.5-25.5 26-25.5S72 61 74 78z" fill="${ACCENT}" stroke="${NAVY}" stroke-width="3" stroke-linejoin="round"/>
  `,
  resources: `
    <circle cx="48" cy="48" r="46" fill="${SAND_BG}"/>
    <path d="M24 30c8-4 16-4 22 0v40c-6-4-14-4-22 0z" fill="#fff" stroke="${NAVY}" stroke-width="3" stroke-linejoin="round"/>
    <path d="M70 30c-8-4-16-4-22 0v40c6-4 14-4 22 0z" fill="${NAVY_BG}" stroke="${NAVY}" stroke-width="3" stroke-linejoin="round"/>
    <circle cx="70" cy="26" r="10" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2"/>
    <circle cx="70" cy="26" r="3.5" fill="#fff"/>
    <line x1="70" y1="13" x2="70" y2="17" stroke="${NAVY}" stroke-width="2"/>
    <line x1="70" y1="35" x2="70" y2="39" stroke="${NAVY}" stroke-width="2"/>
    <line x1="57" y1="26" x2="61" y2="26" stroke="${NAVY}" stroke-width="2"/>
    <line x1="79" y1="26" x2="83" y2="26" stroke="${NAVY}" stroke-width="2"/>
  `,
  godmode: `
    <circle cx="48" cy="48" r="46" fill="${NAVY_BG}"/>
    <path d="M52 20L30 56h14l-4 20 26-38H52z" fill="${ACCENT}" stroke="${NAVY}" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="66" cy="28" r="3" fill="${NAVY}"/>
    <circle cx="73" cy="41" r="2" fill="${NAVY}"/>
    <circle cx="60" cy="19" r="2" fill="${NAVY}"/>
  `,
};

const inner = icons[name] ?? icons.personal;
---

<svg
  class="tile-icon"
  viewBox="0 0 96 96"
  width="96"
  height="96"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  set:html={inner}
/>
